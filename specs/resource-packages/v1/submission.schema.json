{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "submission.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "submission_version": {
      "const": 1
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$",
      "maxLength": 160
    },
    "publisher_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "build_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "path"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "https"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            }
          },
          "required": [
            "type",
            "url",
            "sha256",
            "bytes"
          ]
        }
      ]
    },
    "release_notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "submission_version",
    "resource_id",
    "publisher_id",
    "version",
    "build_revision",
    "source",
    "release_notes"
  ]
}
