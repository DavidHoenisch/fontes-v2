{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fontes library catalog draft protocol 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalog_protocol_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "channel": {
      "enum": [
        "stable",
        "preview"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "snapshot",
        "url",
        "sha256",
        "bytes"
      ]
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$",
            "maxLength": 160
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "resource_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$",
              "maxLength": 160
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "resource_ids"
        ]
      },
      "minItems": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0
    }
  },
  "required": [
    "catalog_protocol_version",
    "repository",
    "channel",
    "sequence",
    "published_at",
    "signing_key_id",
    "taxonomy",
    "bundles",
    "resources"
  ],
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$",
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "build_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "kind": {
          "enum": [
            "translation",
            "commentary",
            "lexicon",
            "word-study",
            "study-guide",
            "devotional",
            "book"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "author",
                  "editor",
                  "translator",
                  "compiler"
                ]
              },
              "id": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "role"
            ]
          },
          "minItems": 1
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
              "maxLength": 120
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "name"
          ]
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "license_id": {
              "type": "string",
              "minLength": 1
            },
            "rights_holder": {
              "type": "string",
              "minLength": 1
            },
            "attribution": {
              "type": "string",
              "minLength": 1
            },
            "permissions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "offline_display": {
                  "const": "allow"
                },
                "keyword_search": {
                  "const": "allow"
                },
                "export": {
                  "enum": [
                    "allow",
                    "deny"
                  ]
                },
                "print": {
                  "enum": [
                    "allow",
                    "deny"
                  ]
                },
                "embeddings": {
                  "enum": [
                    "allow",
                    "deny"
                  ]
                },
                "ai_context": {
                  "enum": [
                    "allow",
                    "deny"
                  ]
                }
              },
              "required": [
                "offline_display",
                "keyword_search",
                "export",
                "print",
                "embeddings",
                "ai_context"
              ]
            },
            "distribution": {
              "const": "public_free"
            },
            "rights_review_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "license_id",
            "rights_holder",
            "attribution",
            "permissions",
            "distribution",
            "rights_review_id"
          ]
        },
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "thumbnail": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "media_type": {
                  "enum": [
                    "image/png",
                    "image/jpeg"
                  ]
                },
                "width": {
                  "const": 200
                },
                "height": {
                  "const": 300
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "url",
                "sha256",
                "bytes",
                "media_type",
                "width",
                "height",
                "alt"
              ]
            },
            "detail": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "media_type": {
                  "enum": [
                    "image/png",
                    "image/jpeg"
                  ]
                },
                "width": {
                  "const": 600
                },
                "height": {
                  "const": 900
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "url",
                "sha256",
                "bytes",
                "media_type",
                "width",
                "height",
                "alt"
              ]
            },
            "license_id": {
              "type": "string",
              "minLength": 1
            },
            "rights_holder": {
              "type": "string",
              "minLength": 1
            },
            "attribution": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "thumbnail",
            "detail",
            "license_id",
            "rights_holder",
            "attribution"
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "complete",
                "selected"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "canonical_registry_version": {
              "const": 1
            },
            "linked_block_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "unmapped_reference_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "mode",
            "summary",
            "canonical_registry_version",
            "linked_block_count",
            "unmapped_reference_count"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$",
                "maxLength": 160
              },
              "minimum_version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "resource_id",
              "minimum_version",
              "required"
            ]
          },
          "minItems": 0
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "compressed_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "expanded_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "library_schema_version": {
              "const": 2
            },
            "package_protocol_version": {
              "const": 1
            },
            "minimum_app_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            }
          },
          "required": [
            "url",
            "sha256",
            "compressed_bytes",
            "expanded_bytes",
            "library_schema_version",
            "package_protocol_version",
            "minimum_app_version"
          ]
        },
        "release_notes": {
          "type": "string",
          "minLength": 1
        },
        "metadata_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "resource_id",
        "version",
        "build_revision",
        "title",
        "description",
        "kind",
        "language",
        "contributors",
        "publisher",
        "rights",
        "cover",
        "coverage",
        "capabilities",
        "dependencies",
        "artifact",
        "release_notes",
        "metadata_sha256"
      ]
    }
  }
}
