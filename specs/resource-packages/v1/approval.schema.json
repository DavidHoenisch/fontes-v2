{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval_version": {
      "const": 1
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$",
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "distribution": {
      "enum": [
        "public_free",
        "private_restricted"
      ]
    },
    "rights_review_id": {
      "type": "string",
      "minLength": 1
    },
    "publisher_review_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "approval_version",
    "resource_id",
    "version",
    "source_sha256",
    "distribution",
    "rights_review_id",
    "publisher_review_id"
  ]
}
