<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:r="urn:fontes:resource:1" targetNamespace="urn:fontes:resource:1" elementFormDefault="qualified">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="resource">
    <xs:complexType><xs:sequence>
      <xs:element name="title" type="r:Title"/><xs:element name="subtitle" type="r:Title" minOccurs="0"/>
      <xs:element name="description" type="r:Description"/>
      <xs:element name="contributors"><xs:complexType><xs:sequence><xs:element name="contributor" minOccurs="1" maxOccurs="64"><xs:complexType><xs:simpleContent><xs:extension base="r:Title"><xs:attribute name="role" use="required"><xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="author"/><xs:enumeration value="editor"/><xs:enumeration value="translator"/><xs:enumeration value="compiler"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="id" type="xs:anyURI"/></xs:extension></xs:simpleContent></xs:complexType></xs:element></xs:sequence></xs:complexType></xs:element>
      <xs:element name="publisher"><xs:complexType><xs:simpleContent><xs:extension base="r:Title"><xs:attribute name="id" type="r:PublisherId" use="required"/></xs:extension></xs:simpleContent></xs:complexType></xs:element>
      <xs:element name="edition" type="r:Title" minOccurs="0"/><xs:element name="publication-date" type="r:PublicationDate" minOccurs="0"/>
      <xs:element name="cover"><xs:complexType><xs:attribute name="href" type="r:Path" use="required"/><xs:attribute name="media-type" use="required"><xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="image/png"/><xs:enumeration value="image/jpeg"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="width" type="xs:positiveInteger" use="required" fixed="1200"/><xs:attribute name="height" type="xs:positiveInteger" use="required" fixed="1800"/><xs:attribute name="alt" type="r:Description" use="required"/><xs:attribute name="license-id" type="r:Title" use="required"/><xs:attribute name="rights-holder" type="r:Title" use="required"/><xs:attribute name="attribution" type="r:Description" use="required"/></xs:complexType></xs:element>
      <xs:element name="references"><xs:complexType><xs:attribute name="canonical-registry" type="xs:token" use="required" fixed="fontes-protestant-66-v1"/><xs:attribute name="source-versification" type="r:Title" use="required"/></xs:complexType></xs:element>
      <xs:element name="coverage"><xs:complexType><xs:sequence><xs:element name="range" maxOccurs="unbounded"><xs:complexType><xs:attribute name="start" type="r:Osis" use="required"/><xs:attribute name="end" type="r:Osis"/></xs:complexType></xs:element></xs:sequence><xs:attribute name="mode" use="required"><xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="complete"/><xs:enumeration value="selected"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType></xs:element>
      <xs:element name="rights"><xs:complexType><xs:sequence><xs:element name="copyright" type="r:Description"/><xs:element name="attribution" type="r:Description"/><xs:element name="permissions"><xs:complexType><xs:attribute name="offline-display" type="r:Permission" use="required"/><xs:attribute name="keyword-search" type="r:Permission" use="required"/><xs:attribute name="export" type="r:Permission" use="required"/><xs:attribute name="print" type="r:Permission" use="required"/><xs:attribute name="embeddings" type="r:Permission" use="required"/><xs:attribute name="ai-context" type="r:Permission" use="required"/></xs:complexType></xs:element></xs:sequence><xs:attribute name="license-id" type="r:Title" use="required"/><xs:attribute name="rights-holder" type="r:Title" use="required"/><xs:attribute name="license-file" type="r:Path" use="required" fixed="rights/LICENSE.txt"/><xs:attribute name="attribution-file" type="r:Path" use="required" fixed="rights/ATTRIBUTION.txt"/></xs:complexType></xs:element>
      <xs:element name="provenance" minOccurs="0"><xs:complexType><xs:sequence><xs:element name="source" type="xs:anyURI" minOccurs="0" maxOccurs="64"/><xs:element name="identifier" type="r:Title" minOccurs="0" maxOccurs="64"/></xs:sequence></xs:complexType></xs:element>
    </xs:sequence><xs:attribute name="format-version" type="xs:positiveInteger" use="required" fixed="1"/><xs:attribute name="id" type="r:ResourceId" use="required"/><xs:attribute name="version" type="r:Version" use="required"/><xs:attribute name="kind" type="r:Kind" use="required"/><xs:attribute name="language" type="xs:language" use="required"/></xs:complexType>
  </xs:element>
</xs:schema>
