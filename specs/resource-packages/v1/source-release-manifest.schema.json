{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-release-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_release_protocol": {
      "const": 1
    },
    "artifact_kind": {
      "const": "validated_source_package"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tooling_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_tag": {
      "type": "string",
      "minLength": 1
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$",
      "maxLength": 160
    },
    "publisher_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "build_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "distribution": {
      "enum": [
        "public_free",
        "private_restricted"
      ]
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1
    },
    "source_archive": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "taxonomy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "source_release_protocol",
    "artifact_kind",
    "repository",
    "source_repository",
    "source_commit",
    "release_commit",
    "tooling_commit",
    "release_tag",
    "resource_id",
    "publisher_id",
    "version",
    "build_revision",
    "distribution",
    "signing_key_id",
    "source_archive",
    "source_sha256",
    "taxonomy_sha256",
    "policy_sha256",
    "approved",
    "entries"
  ]
}
