<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:r="urn:fontes:resource:1" targetNamespace="urn:fontes:resource:1" elementFormDefault="qualified">
  <xs:include schemaLocation="common.xsd"/>
  <xs:complexType name="DocumentIndex"><xs:attribute name="id" type="r:LocalId" use="required"/><xs:attribute name="title" type="r:Title" use="required"/><xs:attribute name="href" type="r:Path" use="required"/></xs:complexType>
  <xs:complexType name="Section"><xs:choice maxOccurs="unbounded"><xs:element name="section" type="r:Section"/><xs:element name="document" type="r:DocumentIndex"/></xs:choice><xs:attribute name="id" type="r:LocalId" use="required"/><xs:attribute name="title" type="r:Title" use="required"/></xs:complexType>
  <xs:element name="index"><xs:complexType><xs:choice maxOccurs="unbounded"><xs:element name="section" type="r:Section"/><xs:element name="document" type="r:DocumentIndex"/></xs:choice><xs:attribute name="format-version" type="xs:positiveInteger" use="required" fixed="1"/><xs:attribute name="resource-id" type="r:ResourceId" use="required"/></xs:complexType>
    <xs:unique name="documentPaths"><xs:selector xpath=".//r:document"/><xs:field xpath="@href"/></xs:unique>
    <xs:unique name="documentIds"><xs:selector xpath=".//r:document"/><xs:field xpath="@id"/></xs:unique>
    <xs:unique name="sectionIds"><xs:selector xpath=".//r:section"/><xs:field xpath="@id"/></xs:unique>
  </xs:element>
</xs:schema>
