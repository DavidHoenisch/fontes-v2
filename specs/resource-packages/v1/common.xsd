<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:r="urn:fontes:resource:1" targetNamespace="urn:fontes:resource:1" elementFormDefault="qualified">
  <xs:simpleType name="ResourceId"><xs:restriction base="xs:token"><xs:pattern value="[a-z][a-z0-9-]*(\.[a-z][a-z0-9-]*){2,}"/><xs:maxLength value="160"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="PublisherId"><xs:restriction base="xs:token"><xs:pattern value="[a-z][a-z0-9-]*(\.[a-z][a-z0-9-]*)+"/><xs:maxLength value="120"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Version"><xs:restriction base="xs:token"><xs:pattern value="(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="LocalId"><xs:restriction base="xs:NCName"><xs:pattern value="[a-z][a-z0-9_.-]*"/><xs:maxLength value="96"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Path"><xs:restriction base="xs:token"><xs:pattern value="[a-zA-Z0-9_-]+(/[a-zA-Z0-9_.-]+)*"/><xs:maxLength value="240"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Title"><xs:restriction base="xs:token"><xs:minLength value="1"/><xs:maxLength value="240"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Description"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="4000"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="PublicationDate"><xs:union memberTypes="xs:date xs:gYearMonth xs:gYear"/></xs:simpleType>
  <xs:simpleType name="Kind"><xs:restriction base="xs:token"><xs:enumeration value="translation"/><xs:enumeration value="commentary"/><xs:enumeration value="lexicon"/><xs:enumeration value="word-study"/><xs:enumeration value="study-guide"/><xs:enumeration value="devotional"/><xs:enumeration value="book"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Permission"><xs:restriction base="xs:token"><xs:enumeration value="allow"/><xs:enumeration value="deny"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Osis"><xs:restriction base="xs:token"><xs:pattern value="[1-3]?[A-Za-z]+(\.[1-9][0-9]*){0,2}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="StrongsCode"><xs:restriction base="xs:token"><xs:pattern value="[GH][0-9]{4,5}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Basis"><xs:restriction base="xs:token"><xs:enumeration value="author"/><xs:enumeration value="source"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="ScriptureRelation"><xs:restriction base="xs:token"><xs:enumeration value="text-of"/><xs:enumeration value="applies-to"/><xs:enumeration value="cites"/><xs:enumeration value="quotes"/><xs:enumeration value="alludes-to"/></xs:restriction></xs:simpleType>
  <xs:complexType name="ScriptureAnnotation">
    <xs:attribute name="start" type="r:Osis" use="required"/><xs:attribute name="end" type="r:Osis"/>
    <xs:attribute name="relation" type="r:ScriptureRelation" use="required"/><xs:attribute name="basis" type="r:Basis" use="required"/>
    <xs:attribute name="witness" type="xs:anyURI"/>
  </xs:complexType>
  <xs:complexType name="ConceptAnnotation"><xs:attribute name="id" type="xs:anyURI" use="required"/><xs:attribute name="relation" use="required"><xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="discusses"/><xs:enumeration value="defines"/><xs:enumeration value="illustrates"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType>
  <xs:complexType name="StrongsAnnotation"><xs:attribute name="code" type="r:StrongsCode" use="required"/><xs:attribute name="relation" use="required"><xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="defines"/><xs:enumeration value="discusses"/><xs:enumeration value="uses"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType>
  <xs:complexType name="InlineReference" mixed="true"><xs:attribute name="start" type="r:Osis" use="required"/><xs:attribute name="end" type="r:Osis"/><xs:attribute name="relation" default="cites"><xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="cites"/><xs:enumeration value="quotes"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="basis" type="r:Basis" default="author"/><xs:attribute name="witness" type="xs:anyURI"/></xs:complexType>
  <xs:complexType name="InlineStrongs" mixed="true"><xs:attribute name="code" type="r:StrongsCode" use="required"/></xs:complexType>
  <xs:complexType name="InlineConcept" mixed="true"><xs:attribute name="concept" type="xs:anyURI" use="required"/></xs:complexType>
  <xs:complexType name="InlineImage"><xs:attribute name="src" type="r:Path" use="required"/><xs:attribute name="alt" type="r:Description" use="required"/></xs:complexType>
  <xs:complexType name="Text" mixed="true"><xs:choice minOccurs="0" maxOccurs="unbounded"><xs:element name="em" type="r:Text"/><xs:element name="ref" type="r:InlineReference"/><xs:element name="strongs" type="r:InlineStrongs"/><xs:element name="term" type="r:InlineConcept"/><xs:element name="image" type="r:InlineImage"/></xs:choice></xs:complexType>
  <xs:complexType name="Annotations"><xs:choice minOccurs="1" maxOccurs="unbounded"><xs:element name="scripture" type="r:ScriptureAnnotation"/><xs:element name="concept" type="r:ConceptAnnotation"/><xs:element name="strongs" type="r:StrongsAnnotation"/></xs:choice></xs:complexType>
</xs:schema>
