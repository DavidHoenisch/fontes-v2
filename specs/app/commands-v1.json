{
  "commands": [
    {
      "description": "Read the current passage, session and library metadata.",
      "inputSchema": {
        "$defs": {
          "AnnotationKind": {
            "enum": [
              "note",
              "highlight"
            ],
            "type": "string"
          },
          "Preferences": {
            "additionalProperties": false,
            "properties": {
              "line_spacing": {
                "format": "float",
                "type": "number"
              },
              "scripture_serif": {
                "type": "boolean"
              },
              "text_size": {
                "format": "float",
                "type": "number"
              },
              "theme": {
                "$ref": "#/$defs/ReadingTheme",
                "default": "sea_glass"
              },
              "verse_numbers": {
                "type": "boolean"
              }
            },
            "required": [
              "text_size",
              "line_spacing",
              "verse_numbers",
              "scripture_serif"
            ],
            "type": "object"
          },
          "ReadingTheme": {
            "description": "Stable theme IDs; palette values and presentation remain in the UI layer.",
            "enum": [
              "sea_glass",
              "ink_saffron",
              "charcoal_raspberry",
              "cobalt_citron",
              "terracotta_linen",
              "aubergine_apricot",
              "midnight_mint"
            ],
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "name": "workspace.get"
    },
