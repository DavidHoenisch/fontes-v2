{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fontes source Strong’s word tags v1",
  "description": "Optional verse_texts.display_json.source_strongs. Source-provided dictionary associations, not original-token alignments. Offsets count Unicode scalar values in the exact verse text; end is exclusive. Hash, snapshot existence, dictionary codes, non-overlap and bounds require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "verse_text_id", "source_snapshot_id", "text_sha256", "spans"],
  "properties": {
    "version": {"const": 1},
    "verse_text_id": {"type": "string", "minLength": 1},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spans": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["start", "end", "codes"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "codes": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[HG][0-9]{4}$"}}
        }
      }
    }
  }
}
