# npm run dev defaults to the local developer persona; no login required.
# Bypass is rejected outside NODE_ENV=development/test or on deployment platforms.
FONTES_AUTH_MODE=development
FONTES_APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://REPLACE_WITH_DEVELOPMENT_CONNECTION
NEON_AUTH_BASE_URL=https://REPLACE_WITH_NEON_AUTH_URL/neondb/auth
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# In managed-auth mode, role grants are provisioned in fontes_cloud.accounts.
# New users always receive publisher capability only. No client-supplied roles.
